# Copie para .env.local (dev, ignorado pelo git) e cadastre na Vercel (Settings → Environment Variables → Production).
# O repositório é PÚBLICO: nunca coloque valores reais neste arquivo.

# Supabase (projeto compartilhado com a Sólida e o Gaspar; tabelas com prefixo lmtubos_)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # Project Settings → API keys → service_role (secreta)

# Login do /dashboard
DASHBOARD_PASSWORD=                   # senha única do painel (mín. 8 caracteres)
DASHBOARD_SECRET=                     # string aleatória longa (mín. 16) para assinar o token de login

# Google Ads (MCC da M|P Assessoria)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=             # escopo https://www.googleapis.com/auth/adwords
GOOGLE_ADS_LOGIN_CUSTOMER_ID=         # ID da MCC (sem hífens)
GOOGLE_ADS_CUSTOMER_ID=               # conta da LM Tubos: 3285786686 (NÃO a da agência)
# GOOGLE_ADS_API_VERSION=v25          # opcional
